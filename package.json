{
  "name": "week-1-nodejs-typescript",
  "version": "1.0.0",
  "description": "Week 1: JavaScript, TypeScript & Node.js - simple Node.js/TypeScript HTTP server with multiple endpoints",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "node --watch src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=23.6"
  },
  "keywords": ["nodejs", "typescript", "http-server", "week-1"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "dotenv": "^16.3.1"
  }
}
